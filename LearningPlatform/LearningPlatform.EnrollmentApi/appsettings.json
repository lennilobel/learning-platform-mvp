{
	"Hosting": {
		"RunBackgroundServices": true	// true = single-process hosting model (monolithic architecture), false = decomposed hosting model (microservices architecture)
	},
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*"
}
